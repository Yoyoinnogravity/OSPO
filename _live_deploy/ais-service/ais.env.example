# Candooka coastal AIS — /etc/candooka/ais.env
#
# Primary (required for live stream): free key via GitHub login
#   https://aisstream.io
AISSTREAM_API_KEY=

# Optional fallback when AISStream is down / idle
# Username from AISHub after sharing a terrestrial receiver feed
#   https://www.aishub.net/api
AISHUB_USERNAME=
